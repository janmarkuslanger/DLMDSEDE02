# Copy to .env and adjust. .env is git-ignored.

# MinIO (data lake) - root credentials, used only by minio-init
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio

# Airflow metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow
AIRFLOW_DB_NAME=airflow

# Serving DB (gold features for the ML application)
SERVING_DB_USER=serving
SERVING_DB_PASSWORD=change-me-serving
SERVING_DB_NAME=serving

# Salt for pseudonymizing Customer ID in silver (keep secret, do not change after first run)
PSEUDONYM_SALT=change-me-salt
